includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    paths:
        - app
        - database

    # Conservative starting level for a codebase that's never run static
    # analysis before. Raise it (up to 9) as violations are cleared —
    # see https://phpstan.org/user-guide/rule-levels
    level: 5

    tmpDir: storage/phpstan

    # Larastan infers model properties from migrations, but only scans
    # database/migrations by default. Every module keeps its own migrations
    # (loaded via ModuleServiceProvider::loadMigrationsFrom), so without this
    # every column access looked like an "undefined property" and had to be
    # baselined. Setting this replaces the default, so list both.
    databaseMigrationsPath:
        - database/migrations
        - app/Modules/*/database/migrations

    # User is the one model that declares casts via casts() instead of $casts.
    # Without this Larastan ignores that method's body, so e.g.
    # pending_email_expires_at (cast 'datetime') was typed as a string.
    parseModelCastsMethod: true

    excludePaths:
        - app/Modules/*/database/migrations/*
